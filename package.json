{
  "name": "delegate-portal-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only delegate and governance dashboard for Soroban DAOs: decoded proposals, published delegate formulas and execution risk from the pinned parser WASM and the governance-event-indexer GraphQL API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Stellar-Governance-Guardians/delegate-portal-dashboard.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/unpack-wasm.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/unpack-wasm.mjs",
    "build": "next build",
    "start": "next start",
    "pretypecheck": "node scripts/unpack-wasm.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "pretest:unit": "node scripts/unpack-wasm.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check:pins": "node scripts/check-pins.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "27.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
