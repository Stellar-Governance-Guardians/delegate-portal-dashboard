# Copy to `.env.local` (gitignored) for `npm run dev`.
#
# The ONLY data source for data pages. There is no default: unset means the
# pages show an explicit "INDEXER_URL is not set" state, never a fallback.
# Not a secret — a public read-only GraphQL endpoint.
INDEXER_URL=http://127.0.0.1:4000/graphql
